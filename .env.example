# Menos Code — API Configuration
# Copy this file to .env and add your OpenRouter API keys
# Get free keys at: https://openrouter.ai/settings/keys

PORT=3000
NODE_ENV=production

# Add 1-10 API keys (more keys = less rate limiting)
API_KEY_1=your-openrouter-key-here
API_KEY_2=your-openrouter-key-here
API_KEY_3=your-openrouter-key-here
API_KEY_4=your-openrouter-key-here
API_KEY_5=your-openrouter-key-here
API_KEY_6=your-openrouter-key-here
API_KEY_7=your-openrouter-key-here
API_KEY_8=your-openrouter-key-here
API_KEY_9=your-openrouter-key-here
API_KEY_10=your-openrouter-key-here
